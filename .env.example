# CampusPilot AI — environment variables (template).
# Copy this file to .env.local and fill in values there. .env.local is git-ignored; never commit real keys.
# The app works fully without any of these (rule-based mode).

# --- Gemini (optional, FREE TIER ONLY) ---
# Create a key in Google AI Studio on a project WITHOUT a billing account (Projects page → Billing Tier shows "Free").
GEMINI_API_KEY=
# Must be one of CampusPilot's free-tier allowlist: gemini-3.5-flash-lite (default) or gemini-3.1-flash-lite.
# Any other model is refused (AI turns off). CampusPilot never switches models automatically.
GEMINI_MODEL=gemini-3.5-flash-lite
# Local safety limits (can only be lowered below the hard caps of 10/minute and 200/day).
GEMINI_MAX_REQUESTS_PER_MINUTE=8
GEMINI_MAX_REQUESTS_PER_DAY=150

# --- Optional live internship data from PUBLIC job-board APIs (no key; no student data sent) ---
# Comma-separated board slugs, e.g. the "acme" in boards.greenhouse.io/acme or jobs.lever.co/acme.
JOB_GREENHOUSE_BOARDS=
JOB_LEVER_COMPANIES=
