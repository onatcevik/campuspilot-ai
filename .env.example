# Optional. Without a key, CampusPilot AI runs fully on clearly labeled rule-based logic.
# Copy to .env.local and add your key. Never commit .env.local.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional live internship data from PUBLIC job-board APIs (no API key; no student data is sent).
# Comma-separated board slugs, e.g. the "acme" in boards.greenhouse.io/acme or jobs.lever.co/acme.
# Only DC / Northern Virginia / Maryland internship, co-op and new-grad tech roles are kept.
JOB_GREENHOUSE_BOARDS=
JOB_LEVER_COMPANIES=
